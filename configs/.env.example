# ─────────────────────────────────────────────────
# Speed Layer — Environment Variables
# Copy this file:  cp configs/.env.example .env
# ─────────────────────────────────────────────────

# ── Kafka ────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JOBS_RAW_TOPIC=jobs_raw
JOBS_CLEAN_TOPIC=jobs_clean
JOBS_DLQ_TOPIC=jobs_dead_letter

# ── Legacy topic names (for existing producer) ───
RAW_TOPIC=raw_events
DLQ_TOPIC=raw_events_dlq

# ── Spark ────────────────────────────────────────
SPARK_MASTER=local[*]
STREAM_TRIGGER_INTERVAL=30 seconds
STREAM_WATERMARK_DELAY=1 hour

# ── Checkpoints ──────────────────────────────────
CHECKPOINT_BASE=/tmp/job-market-checkpoints/speed
CHECKPOINT_DIR=/tmp/speed_layer_checkpoints
TRIGGER_SECONDS=10

# ── Crawler / Producer ───────────────────────────
CRAWLER_OUTPUT_DIR=data/raw
PRODUCER_SENT_STATE=.state/producer_sent_records.json
PRODUCER_DELAY_SECONDS=0

# ── Cassandra ────────────────────────────────────
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_USERNAME=cassandra
CASSANDRA_PASSWORD=cassandra
CASSANDRA_KEYSPACE=job_market
CASSANDRA_TTL_SECONDS=7200

# ── Elasticsearch ────────────────────────────────
ELASTICSEARCH_HOST=http://localhost:9200
ES_URL=http://localhost:9200
ES_INDEX_JOBS=jobs_clean_realtime
ES_INDEX_JOB_COUNTS=realtime_jobs_per_10m
ES_INDEX_SKILL_COUNTS=realtime_top_skills_hourly
ES_INDEX_SALARY_BINS=realtime_salary_bins_10m

# ── Redis (legacy) ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=7200
