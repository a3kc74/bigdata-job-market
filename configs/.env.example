# ─────────────────────────────────────────────────
# Speed Layer — Environment Variables
# Copy this file:  cp configs/.env.example .env
# ─────────────────────────────────────────────────

# ── Kafka ────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RAW_TOPIC=jobs_raw
CLEAN_TOPIC=jobs_clean
DEAD_LETTER_TOPIC=jobs_dead_letter

# ── Spark ────────────────────────────────────────
SPARK_MASTER=local[*]
CHECKPOINT_DIR=/checkpoints/speed
TRIGGER_SECONDS=10
STARTING_OFFSETS=earliest
SPARK_LOG_LEVEL=WARN

# ── Crawler / Producer ───────────────────────────
CRAWLER_OUTPUT_DIR=data/raw
PRODUCER_SENT_STATE=.state/producer_sent_records.json
PRODUCER_DELAY_SECONDS=0

# ── Elasticsearch ────────────────────────────────
ES_URL=http://localhost:9200
ES_INDEX_JOBS=realtime_jobs_v1
ES_INDEX_JOB_COUNTS_10M=realtime_job_counts_10m_v1
ES_INDEX_SKILL_COUNTS_HOURLY=realtime_skill_counts_hourly_v1
ES_INDEX_TOP_SKILLS_HOURLY=realtime_top_skills_hourly_v1
ES_INDEX_SALARY_BINS_HOURLY=realtime_salary_bins_hourly_v1

# ── Streaming Flags ──────────────────────────────
WRITE_ELASTICSEARCH=true
WRITE_CONSOLE_DEBUG=false
ENABLE_JOBS_PER_10M=true
ENABLE_TOP_SKILLS_HOURLY=true
ENABLE_SALARY_BINS_HOURLY=true
TOP_SKILLS_HOURLY_N=10
